[Unit]
Description=SLFox Music FastAPI Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/slfox-music
EnvironmentFile=/opt/slfox-music/.env
ExecStart=/opt/slfox-music/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
