APP_NAME=SLFox Music
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:////opt/slfox-music/data/music_service.db
UPLOAD_DIR=/opt/slfox-music/uploads

CORS_ALLOW_ORIGINS=["https://music.tenebraefox.xyz"]
TRUSTED_HOSTS=["music.tenebraefox.xyz"]
FORCE_HTTPS_REDIRECT=true

PBKDF2_ALG=sha256
PBKDF2_ITERATIONS=390000
PBKDF2_SALT_BYTES=16

SMTP_ENABLED=true
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=mailer@tenebraefox.xyz
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@music.tenebraefox.xyz
SMTP_USE_TLS=true
SMTP_USE_SSL=false

DEBUG_RETURN_CODES=false
